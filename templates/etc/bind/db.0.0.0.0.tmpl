$TTL 1W
@                IN SOA        ns.{{ domain }}. root.{{ domain }}. (
                               {{ time|stringformat:"12d" }} ; Serial
                                         3H ; Refresh
                                        15M ; Retry
                                         1W ; Expire
                                         1D ; Negative Cache TTL
                               )
@                                IN NS      ns.{{ domain }}.

;
; {{ name }}
;
{% for host in hosts -%}
  {%- if host.ip -%}
{{ host.ip.reverse_pointer|stringformat:"-32s" }} IN PTR     {{ host.hostname }}.{{ domain }}.
{% endif %}
{%- endfor %}

; {{ network.dynamic.format }} ({{ network.dynamic_start }} - {{ network.dynamic_end }})
{% for n in network.dynamic_range -%}
{{ n.reverse_pointer|stringformat:"-32s" }} IN PTR     {{ dynamic.format|format:forloop.counter0 }}.{{ domain }}.
{% endfor %}
