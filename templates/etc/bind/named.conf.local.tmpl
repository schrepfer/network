//
// Do any local configuration here
//

zone "{{ domain }}" {
  type master;
  file "/etc/bind/db.{{ domain }}";
  allow-update { none; };
  notify no;
};

zone "{{ network_.reverse_pointer }}" {
  type master;
  file "/etc/bind/db.{{ network_.network }}";
  allow-update { none; };
  notify no;
};
