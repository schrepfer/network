$TTL 1W
@                IN SOA        ns.{{ domain }}. root.{{ domain }}. (
                               {{ time|stringformat:"12d" }} ; Serial
                                         3H ; Refresh
                                        15M ; Retry
                                         1W ; Expire
                                         1D ; Negative Cache TTL
                               )
@                IN NS         ns
@                IN MX         10 mail
@                IN A          {{ gateway }}
ns               IN A          {{ ns }}
mail             IN A          {{ mail }}
; Hosts{% for host in hosts %}{% if host.ip %}
{{ host.hostname|stringformat:"-24s" }} IN A          {{ host.ip }}{% for alias in host.aliases %}
{{ alias|stringformat:"-24s" }} IN CNAME      {{ host.hostname }}{% endfor %}{% endif %}{% endfor %}{% for vlan in vlans %}{% if vlan.cfg.hosts %}
; {{ vlan.name }} hosts{% for host in vlan.cfg.hosts %}{% if host.ip %}
{{ host.hostname|stringformat:"-24s" }} IN A          {{ host.ip }}{% for alias in host.aliases %}
{{ alias|stringformat:"-24s" }} IN CNAME      {{ host.hostname }}{% endfor %}{% endif %}{% endfor %}{% endif %}{% endfor %}
; Dynamic hosts{% for n in network.dynamic_range %}
{{ dynamic.format|format:forloop.counter0|stringformat:"-24s" }} IN A          {{ n }}{% endfor %}
